# Скопируйте в .env и задайте свой пароль. Файл .env в git не попадает.
POSTGRES_DB=cyberclub
POSTGRES_USER=cyberclub_app
POSTGRES_PASSWORD=укажите_свой_пароль

APP_PORT=8081
POSTGRES_PORT=55433
APP_TIME_ZONE=Europe/Moscow
PERMANENT_DELETE_ENABLED=false

# --- Авторизация ---
# Ключ подписи JWT: не меньше 32 случайных байт в Base64. Сгенерировать в PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Если оставить пустым, ключ создаётся при каждом запуске и после перезапуска все входят заново.
JWT_SECRET_BASE64=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Первый администратор: создаётся при первом запуске, пока в базе нет пользователей.
# Пароль: от 8 символов, буквы и цифры, без имени из email.
BOOTSTRAP_ADMIN_EMAIL=admin@cyberclub.local
BOOTSTRAP_ADMIN_NAME=Администратор клуба
BOOTSTRAP_ADMIN_PASSWORD=укажите_пароль_администратора
