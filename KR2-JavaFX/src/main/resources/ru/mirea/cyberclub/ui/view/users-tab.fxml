<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!-- Вкладка «Пользователи» (видна только администратору). Данные — на сервере КР3. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.cyberclub.ui.controller.UsersController"
            styleClass="tab-content">
    <top>
        <HBox styleClass="action-bar" spacing="8" alignment="CENTER_LEFT">
            <Button text="＋ Зарегистрировать" styleClass="primary-button" onAction="#onRegister"/>
            <Button fx:id="toggleButton" text="Отключить" onAction="#onToggleEnabled"/>
            <Button fx:id="resetButton" text="Сбросить пароль" onAction="#onResetPassword"/>
            <Button fx:id="unlockButton" text="Снять блокировку" onAction="#onUnlock"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⟳ Обновить" onAction="#refresh"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="240"/>
                <TableColumn fx:id="nameCol" text="Имя" prefWidth="200"/>
                <TableColumn fx:id="roleCol" text="Роль" prefWidth="190"/>
                <TableColumn fx:id="stateCol" text="Состояние" prefWidth="150"/>
                <TableColumn fx:id="lastLoginCol" text="Последний вход" prefWidth="160"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox styleClass="tab-footer" alignment="CENTER_LEFT">
            <Label fx:id="countLabel"/>
        </HBox>
    </bottom>
</BorderPane>
